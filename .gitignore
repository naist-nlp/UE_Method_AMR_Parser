# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/

# GloVe vectors (too large for GitHub, download separately)
similarities/amr-metric-suite/vectors/*.txt
similarities/amr-metric-suite/vectors/*.zip

# AMR 3.0 (LDC2020T02) and parser outputs on it are licensed: never commit them
data/*
!data/README.md
!data/sentence_order.json
!data/AMR3.0/
data/AMR3.0/*
!data/AMR3.0/README.md
*.amr
*.amr.txt
sent_*.json

# Pipeline output files (generated by run_all.py and scripts/)
estimators/results/*.csv
estimators/results/*.json
estimators/results/paper_tables.md

# Score files in estimators/results/cache/ ARE included: numbers only, no text
# from any dataset (see README, "Score files")

# Job logs
logs/*
!logs/.gitkeep

# Generated figures
paper_figures/

